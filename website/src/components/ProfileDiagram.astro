---
import Icon from './Icon.astro';
---

<figure class="profile-diagram diagram" aria-label="Machine profiles select different dotfiles and packages from the same repository">
  <div class="diagram-label"><span>ONE REPO. DIFFERENT PROFILES.</span><Icon name="git" size={16} /></div>
  <div class="profile-repo"><Icon name="git" size={24} /><strong>Your Git repo</strong><span>Dotfiles + package manifests</span></div>
  <div class="team-branches" aria-hidden="true"></div>
  <div class="profile-machines">
    <div><span class="profile-name">WORK</span><h3><Icon name="laptop" size={22} /> Work laptop</h3><ul><li><Icon name="check" size={13} /> Shell config</li><li><Icon name="check" size={13} /> Editor settings</li><li><Icon name="check" size={13} /> Desktop apps</li></ul></div>
    <div><span class="profile-name">SERVER</span><h3><Icon name="monitor" size={22} /> Remote server</h3><ul><li><Icon name="check" size={13} /> Shell config</li><li><Icon name="check" size={13} /> CLI tools</li><li class="profile-excluded">No desktop apps</li></ul></div>
  </div>
  <figcaption class="diagram-caption">Example profiles. You choose the files and packages.</figcaption>
</figure>
