---
import Icon from '../../components/Icon.astro';
import '../../styles/designs.css';
import favicon from '../../assets/favicon.svg?url&no-inline';

export function getStaticPaths() {
  return ['relay', 'current', 'workbench'].map(direction => ({ params: { direction } }));
}

const { direction } = Astro.params;
const names = { relay: 'Relay', current: 'Current', workbench: 'Workbench' };
const name = names[direction as keyof typeof names];
const installCommand = 'brew tap paddo-tech/tap && brew install tether-cli';
const packages = ['Homebrew', 'npm', 'pnpm', 'bun', 'gem', 'uv'];
---

<!doctype html>
<html lang="en" data-direction={direction} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Sync your dotfiles and packages across machines through your own Git repository." />
    <title>Tether — {name} design</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;450;500;600&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      const requestedTheme = new URLSearchParams(location.search).get('theme');
      document.documentElement.dataset.theme = requestedTheme === 'dark' || requestedTheme === 'light'
        ? requestedTheme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href={`/designs/${direction}`} aria-label="Tether home"><Icon name="link" size={29} /><span>tether<span class="cli-label">CLI</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href="/docs">Docs</a><a href="/teams">Teams</a><a href="/security">Security</a></nav>
      <div class="nav-actions">
        <button class="theme-toggle" aria-label="Switch to dark mode"><span class="sun"><Icon name="sun" size={19} /></span><span class="moon"><Icon name="moon" size={19} /></span></button>
        <a class="github-link" href="https://github.com/paddo-tech/tether-cli">GitHub <span>↗</span></a>
        <details class="mobile-nav"><summary aria-label="Navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="/docs">Docs</a><a href="/teams">Teams</a><a href="/security">Security</a><a href="https://github.com/paddo-tech/tether-cli">GitHub ↗</a></nav></details>
      </div>
    </header>

    <main id="main">
      {direction === 'relay' && <>
        <section class="relay-hero wrap">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> YOUR MACHINES. ONE ENVIRONMENT.</p>
            <h1>Different machines.<br /><em>Same setup.</em></h1>
            <p class="lede">Your shell, your packages, your familiar shortcuts. Tether keeps them in sync through a Git repo you control.</p>
            <div class="hero-actions"><a class="button primary" href="#install">Get Tether <Icon name="arrow" size={19} /></a><a class="text-link" href="/docs">Read the docs <span>↗</span></a></div>
            <p class="availability">Open source · macOS · Linux beta</p>
          </div>
          <div class="relay-map" aria-label="A laptop and desktop sync encrypted dotfiles through your Git repository">
            <div class="map-heading"><span>YOUR SYNC NETWORK</span><span class="map-status"><span class="status-dot"></span> Connected</span></div>
            <div class="device device-left"><Icon name="laptop" size={38} /><strong>Work laptop</strong><span>macOS</span><div class="device-check"><Icon name="check" size={12} /> Synced</div></div>
            <div class="device device-right"><Icon name="monitor" size={38} /><strong>Home desktop</strong><span>macOS</span><div class="device-check"><Icon name="check" size={12} /> Synced</div></div>
            <svg class="map-lines" viewBox="0 0 540 425" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M133 200V222Q133 246 160 246H244M407 200V222Q407 246 380 246H296" /><circle cx="183" cy="246" r="3" /><circle cx="355" cy="246" r="3" /></svg>
            <div class="repo-node"><Icon name="git" size={28} /></div>
            <div class="repo-caption"><strong>Your Git repo</strong><span><Icon name="lock" size={12} /> Encrypted dotfiles</span></div>
            <div class="file-strip"><span>.zshrc</span><span>.gitconfig</span><span>packages</span></div>
            <div class="map-footer"><span>Local files → Encrypt → Git → Your machines</span><span>↔</span></div>
          </div>
        </section>
        <section class="package-band wrap" aria-label="Supported package managers"><span>YOUR TOOLS, ALREADY INCLUDED</span><div>{packages.map(pkg => <strong>{pkg}</strong>)}</div></section>
        <section class="relay-details wrap">
          <div class="section-heading"><p class="eyebrow">LESS SETUP. MORE BUILDING.</p><h2>Keep your environment<br />close, wherever you work.</h2></div>
          <div class="relay-features">
            <article><div class="feature-symbol"><Icon name="git" /></div><h3>Your repo. Your history.</h3><p>Use your own Git repository. Track changes and restore earlier versions when you need them.</p><a href="/docs">Explore the workflow <span>↗</span></a></article>
            <article><div class="feature-symbol"><Icon name="lock" /></div><h3>Private by default.</h3><p>Tether encrypts dotfiles before they reach Git. Your passphrase unlocks them on your machines.</p><a href="/security">Read about encryption <span>↗</span></a></article>
            <article><div class="feature-symbol"><Icon name="box" /></div><h3>More than dotfiles.</h3><p>Sync global packages and project configs. Choose what belongs on each machine with profiles.</p><a href="/docs">See what you can sync <span>↗</span></a></article>
          </div>
        </section>
      </>}

      {direction === 'current' && <>
        <section class="current-hero wrap">
          <p class="eyebrow">FOR EVERY PLACE YOU BUILD</p>
          <h1>Make yourself<br /><em>at home.</em><span class="heading-dot">*</span></h1>
          <div class="current-intro"><p class="lede">A different machine should still feel like yours. Sync your dotfiles and packages with Tether.</p><a class="button primary" href="#install">Bring your setup <Icon name="arrow" size={19} /></a><p class="availability">Your Git repo. Your keys. Open source.</p></div>
          <div class="current-art" aria-label="Tether connects your dotfiles and packages across machines">
            <svg class="ribbon" viewBox="0 0 660 390" fill="none" aria-hidden="true"><path class="ribbon-shadow" d="M-20 270C70 270 58 90 190 90S270 300 410 300 503 110 680 110" /><path class="ribbon-main" d="M-20 250C70 250 58 70 190 70S270 280 410 280 503 90 680 90" /><path class="ribbon-detail" d="M-20 250C70 250 58 70 190 70S270 280 410 280 503 90 680 90" /></svg>
            <div class="floating-file shell-file"><div><span class="file-icon">~</span><span>YOUR SHELL</span><Icon name="check" size={16} /></div><strong>.zshrc</strong><code>alias home='cd ~'<br /><span># Just how you like it.</span></code></div>
            <div class="floating-file package-file"><div><Icon name="box" size={19} /><span>YOUR TOOLS</span><Icon name="check" size={16} /></div><strong>Ready to build.</strong><p>Homebrew <span>·</span> npm <span>·</span> uv</p></div>
            <div class="art-note"><span class="status-dot"></span> Same setup. New surroundings.</div>
          </div>
        </section>
        <section class="current-statement wrap"><span class="asterisk">*</span><p>Keep the parts that make<br />a machine <em>yours.</em></p><span class="statement-note">A small tool.<br />A familiar environment.</span></section>
        <section class="current-features wrap">
          <article><div class="current-feature-top"><Icon name="laptop" size={30} /><span>DOTFILES & CONFIGS</span></div><h2>Your habits.<br />Everywhere.</h2><p>Keep your shell aliases, editor settings, and project configs ready across your machines.</p><a href="/docs">Make it yours <Icon name="arrow" size={18} /></a></article>
          <article><div class="current-feature-top"><Icon name="lock" size={30} /><span>ENCRYPTED SYNC</span></div><h2>A connection<br />you control.</h2><p>Your dotfiles stay encrypted in your Git repo. You hold the passphrase that unlocks them.</p><a href="/security">See how it works <Icon name="arrow" size={18} /></a></article>
          <article><div class="current-feature-top"><Icon name="git" size={30} /><span>BUILT FOR TEAMS, TOO</span></div><h2>Start with<br />common ground.</h2><p>Share team dotfiles and project secrets. Keep your personal settings alongside them.</p><a href="/teams">Bring your team <Icon name="arrow" size={18} /></a></article>
        </section>
      </>}

      {direction === 'workbench' && <>
        <section class="workbench-hero wrap">
          <div class="workbench-copy"><p class="eyebrow"><span class="status-dot"></span> THE CLI FOR YOUR OTHER MACHINE</p><h1>YOUR SETUP.<br />ON REPEAT.</h1><p class="lede">Change a config. Install a tool. Tether keeps your machines in sync, so you can get back to work.</p><a class="button primary" href="#install">Install Tether <Icon name="arrow" size={19} /></a><div class="workbench-tags"><span>RUST</span><span>OPEN SOURCE</span><span>GIT BACKED</span></div></div>
          <div class="workbench-console"><div class="console-title"><span><span class="status-dot"></span> TETHER / SYNC</span><span>EXAMPLE SESSION</span></div><div class="terminal-body"><p><span class="prompt">~ $</span> tether sync<span class="cursor"></span></p><div class="terminal-log"><p><span>✓</span> Scan local changes</p><p><span>✓</span> Encrypt dotfiles</p><p><span>✓</span> Push to your Git repo</p><p><span>✓</span> Apply incoming changes</p></div><p class="terminal-result">Your environment is up to date.</p><div class="terminal-files"><span>DOTFILES</span><span>PACKAGES</span><span>PROJECTS</span></div></div><div class="machine-stack"><div><Icon name="laptop" size={22} /><span>work-macbook<small>Personal profile</small></span><span class="machine-state">SYNCED <Icon name="check" size={14} /></span></div><div><Icon name="monitor" size={22} /><span>home-studio<small>Personal profile</small></span><span class="machine-state">SYNCED <Icon name="check" size={14} /></span></div></div></div>
        </section>
        <section class="workbench-strip"><div class="wrap"><span>ONE BINARY.</span><span>YOUR REPOSITORY.</span><span>EVERY FIVE MINUTES.</span></div></section>
        <section class="workbench-details wrap"><div class="section-heading"><p class="eyebrow">THE RIGHT TOOLS. ALREADY THERE.</p><h2>SET IT UP ONCE.<br />KEEP IT TOGETHER.</h2><p>Keep the routine work in the background.<br />Choose what syncs to each machine.</p><a class="text-link" href="/docs">Open the manual <span>↗</span></a></div><div class="workbench-features"><article><Icon name="git" size={27} /><div><h3>Config changes travel with you.</h3><p>Tether syncs your dotfiles through Git. The daemon checks for changes every five minutes.</p></div><span>.zshrc</span></article><article><Icon name="box" size={27} /><div><h3>Your tools make the trip, too.</h3><p>Sync global packages from Homebrew, npm, pnpm, bun, gem, and uv.</p></div><span>brew</span></article><article><Icon name="lock" size={27} /><div><h3>Your keys stay yours.</h3><p>Tether encrypts dotfiles before pushing them. Your passphrase stays out of the repository.</p></div><span>AES-256</span></article></div></section>
      </>}

      <section id="install" class="install-section wrap">
        <div><p class="eyebrow">READY WHEN YOU ARE</p><h2>{direction === 'current' ? 'Your next machine is already familiar.' : direction === 'workbench' ? 'GET YOUR MACHINES IN SYNC.' : 'Your next machine. Already yours.'}</h2><p>Install Tether, then run <code>tether init</code> to connect your Git repo.</p></div>
        <div class="install-control"><div class="install-label"><span>INSTALL WITH HOMEBREW</span><span>macOS</span></div><div class="install-command"><code>{installCommand}</code><button class="copy-install" data-command={installCommand} aria-label="Copy install command"><Icon name="copy" size={18} /></button></div><div class="install-bottom"><a href="/docs">Setup guide ↗</a><span class="copy-status" role="status">macOS · Linux beta</span></div></div>
      </section>
    </main>
    <footer class="site-footer wrap"><a class="wordmark" href={`/designs/${direction}`}><Icon name="link" size={24} /><span>tether</span></a><p>Your environment, connected.</p><div><a href="https://github.com/paddo-tech/tether-cli">GitHub ↗</a><a href="https://github.com/paddo-tech/tether-cli/blob/main/LICENSE">MIT License</a><a href="/designs">Design options</a></div></footer>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      function updateThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeButton.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
      }
      updateThemeLabel();
      themeButton.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        const url = new URL(location.href);
        url.searchParams.set('theme', theme);
        history.replaceState(null, '', url);
        updateThemeLabel();
        if (window.parent !== window) window.parent.postMessage({ type: 'tether-theme', theme }, location.origin);
      });
      document.querySelector<HTMLButtonElement>('.copy-install')!.addEventListener('click', async event => {
        const button = event.currentTarget as HTMLButtonElement;
        await navigator.clipboard.writeText(button.dataset.command!);
        document.querySelector('.copy-status')!.textContent = 'Install command copied';
        button.setAttribute('aria-label', 'Install command copied');
      });
    </script>
  </body>
</html>
